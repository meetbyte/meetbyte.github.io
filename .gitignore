# Local-only files; these rules do not untrack files already committed.
# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Local editor settings and temporary files
.vscode/
.idea/
*.swp
*.swo
*~
*.tmp
*.log

# Local environment files
.env
.env.*
# Keep a shareable placeholder example, if one is added later.
!.env.example

# Optional local tooling (the site itself has no dependencies)
node_modules/
